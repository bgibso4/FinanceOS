generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id               String            @id @default(uuid())
  name             String
  type             String
  institution      String?
  currency         String            @default("USD")
  isActive         Boolean           @default(true)
  notes            String?
  trackingMode     String            @default("cash_flow")  // "cash_flow" | "balance_only"
  invertAmounts    Boolean           @default(false) // Flip amount signs during bank sync (for accounts with inverted conventions)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  transactions              Transaction[]
  recurringTransactions     RecurringTransaction[]
  goals                     Goal[]
  plaidConnection           PlaidConnection?
  tellerConnection          TellerConnection?
}

// Plaid Enrollment: Institution-level connection (parallels TellerEnrollment)
model PlaidEnrollment {
  id                   String            @id @default(uuid())
  plaidItemId          String            @unique // Plaid's item ID
  institutionId        String?           // Plaid's institution ID
  institutionName      String            // Display name (e.g., "Chase")
  accessTokenEncrypted String            // Encrypted access token
  accessTokenIv        String            // IV for decryption
  transactionCursor    String?           // Sync cursor (shared across all connections)
  status               String            @default("connected")
  lastSyncAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  connections          PlaidConnection[] // Links to FinanceOS accounts

  @@index([status])
}

// Plaid Connection: Links a FinanceOS account to a specific Plaid account
model PlaidConnection {
  id                   String          @id @default(uuid())
  accountId            String          @unique // One Plaid connection per FinanceOS account
  account              Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plaidEnrollmentId    String          // FK to PlaidEnrollment
  plaidEnrollment      PlaidEnrollment @relation(fields: [plaidEnrollmentId], references: [id], onDelete: Cascade)
  plaidAccountId       String          // Specific Plaid account ID
  plaidAccountName     String?         // Display name from Plaid
  plaidAccountType     String?         // Account type (e.g., "depository")
  plaidAccountSubtype  String?         // Account subtype (e.g., "checking")
  plaidAccountMask     String?         // Last 4 digits
  lastSyncAt           DateTime?
  lastSyncStatus       String          @default("never")
  lastSyncError        String?
  status               String          @default("connected")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([plaidEnrollmentId])
  @@index([status])
}

// Teller Enrollment: Institution-level connection
model TellerEnrollment {
  id                   String              @id @default(uuid())
  enrollmentId         String              @unique // Teller's enrollment ID
  institutionId        String              // Teller's institution ID (e.g., "chase")
  institutionName      String              // Display name (e.g., "Chase")
  accessTokenEncrypted String              // Encrypted access token
  accessTokenIv        String              // IV for decryption
  status               String              @default("connected")
  lastSyncAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  connections          TellerConnection[]  // Links to FinanceOS accounts

  @@index([status])
}

// Teller Connection: Links a FinanceOS account to a specific Teller account
model TellerConnection {
  id                   String           @id @default(uuid())
  accountId            String           @unique // One Teller account per FinanceOS account
  account              Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tellerEnrollmentId   String           // FK to TellerEnrollment (NOT unique - many accounts can use same enrollment)
  tellerEnrollment     TellerEnrollment @relation(fields: [tellerEnrollmentId], references: [id], onDelete: Cascade)
  tellerAccountId      String           // Specific Teller account ID (e.g., "acc_xyz123")
  tellerAccountName    String?          // Display name from Teller (e.g., "My Checking")
  tellerAccountType    String?          // Account type (e.g., "depository")
  tellerAccountSubtype String?          // Account subtype (e.g., "checking")
  tellerAccountLastFour String?         // Last 4 digits
  lastSyncAt           DateTime?
  lastSyncDate         String?
  lastSyncStatus       String           @default("never")
  lastSyncError        String?
  status               String           @default("connected")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([tellerEnrollmentId])
  @@index([status])
}

model Category {
  id          String       @id @default(uuid())
  name        String
  parentId    String?
  parent      Category?    @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryToCategory")
  type        String
  createdAt              DateTime               @default(now())
  transactions           Transaction[]
  recurringTransactions  RecurringTransaction[]
  budgets                CategoryBudget[]
  rules                  Rule[]
  goals                  Goal[]
}

model Rule {
  id          String    @id @default(uuid())
  conditions  String    @default("[]") // JSON: array of condition objects with AND logic
  categoryId  String?   // Optional: rule can rename merchant without categorizing
  category    Category? @relation(fields: [categoryId], references: [id])
  renameTo    String?   // Optional: rename merchant to this value when rule matches
  description String?   // Optional: user note describing the rule's purpose
  priority    Int       @default(100)
  isEnabled   Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String   @default("blue")
  createdAt DateTime @default(now())
  goals     Goal[]
}

model Transaction {
  id                 String      @id @default(uuid())
  date               DateTime
  amount             Float
  accountId          String
  account            Account     @relation(fields: [accountId], references: [id])
  merchant           String
  merchantNormalized String      @default("")
  categoryId         String?
  category           Category?   @relation(fields: [categoryId], references: [id])
  tags               String?
  note               String?
  isTransfer         Boolean     @default(false)
  transferGroupId    String?
  confidenceScore    Float       @default(0)
  externalId         String?
  importHash         String?
  
  // Linked transaction tracking (returns, reimbursements, offsets)
  isOffset           Boolean     @default(false)
  linkedTransactionId String?
  linkedTransaction  Transaction? @relation("TransactionOffset", fields: [linkedTransactionId], references: [id], onDelete: SetNull)
  offsetTransactions Transaction[] @relation("TransactionOffset")

  // Split transaction tracking
  isSplitParent       Boolean      @default(false)
  parentTransactionId String?
  parentTransaction   Transaction? @relation("TransactionSplit", fields: [parentTransactionId], references: [id], onDelete: Cascade)
  splitParts          Transaction[] @relation("TransactionSplit")

  createdAt          DateTime    @default(now())

  @@index([date])
  @@index([merchantNormalized])
  @@index([importHash])
  @@index([linkedTransactionId])
  @@index([parentTransactionId])
  @@unique([accountId, externalId])
}

model MonthlySnapshot {
  id              String   @id @default(uuid())
  month           String
  incomeTotal     Float
  spendingTotal   Float
  savingsTotal    Float
  savingsRatePct  Float
  categoryTotals  String
  merchantTotals  String
  createdAt       DateTime @default(now())
}

model NetWorthSnapshot {
  id               String   @id @default(uuid())
  date             DateTime // Snapshot date (typically end of period)
  netWorth         Float    // Total net worth (assets - liabilities)
  totalAssets      Float    // Sum of positive balance accounts
  totalLiabilities Float    // Sum of negative balance accounts (stored as positive)
  accountBalances  String   // JSON: { accountId: { balance, name, type, currency } }
  period           String?  // Optional label: "2024-Q1", "2024-01", etc.
  notes            String?
  isAutomatic      Boolean  @default(false) // Manual vs scheduled capture

  createdAt        DateTime @default(now())

  @@index([date])
}

model CategoryBudget {
  id          String   @id @default(uuid())
  month       String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  limitAmount Float
  createdAt   DateTime @default(now())

  @@unique([month, categoryId], name: "month_categoryId")
}

model Goal {
  id              String    @id @default(uuid())
  name            String
  type            String    // "spending" | "saving"
  targetAmount    Float
  trackingMethod  String    // "category" | "tag" | "account"
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  tagId           String?
  tag             Tag?      @relation(fields: [tagId], references: [id])
  accountId       String?
  account         Account?  @relation(fields: [accountId], references: [id])
  startDate       String?   // ISO date string, null = open-ended start
  endDate         String?   // ISO date string, null = open-ended end
  status          String    @default("active") // "active" | "completed" | "archived"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ExchangeRate {
  id           String   @id @default(uuid())
  fromCurrency String
  toCurrency   String
  rate         Float
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([fromCurrency, toCurrency])
}

model InflationRate {
  id        String   @id @default(uuid())
  year      Int      @unique
  rate      Float    // Annual percentage, e.g. 3.4 for 3.4%
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model UserSettings {
  id           String   @id @default(uuid())
  baseCurrency String   @default("USD")
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model RecurringTransaction {
  id                  String    @id @default(uuid())
  merchantPattern     String    // merchantNormalized value used for matching
  merchantDisplay     String    // Human-readable merchant name (e.g., "Netflix")
  accountId           String
  account             Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId          String?
  category            Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Recurrence pattern
  frequency           String    // "weekly" | "biweekly" | "monthly" | "quarterly" | "annual"
  expectedAmount      Float     // Median amount from detected cluster
  amountVariance      Float     @default(0) // Stddev of amounts
  expectedDayOfMonth  Int?      // For monthly+, the typical billing day (1-31)
  medianIntervalDays  Float     // Raw median interval in days

  // Detection metadata
  confidence          Float     // Combined score: (intervalRegularity * 0.6) + (amountConsistency * 0.4)
  intervalRegularity  Float     // 1 - (stddev/median) of intervals
  amountConsistency   Float     // 1 - (stddev/median) of amounts
  transactionCount    Int       // Number of transactions in detected cluster
  firstSeenDate       DateTime  // Earliest transaction in the cluster
  lastSeenDate        DateTime  // Most recent transaction in the cluster

  // Status & tracking
  status              String    @default("active") // "active" | "paused" | "cancelled" | "lapsed"
  nextExpectedDate    DateTime?
  isManualOverride    Boolean   @default(false) // User manually marked/unmarked
  manuallyCreated     Boolean   @default(false) // User created this entry, not auto-detected

  // Price change tracking
  priceHistory        String    @default("[]") // JSON: [{ date: ISO, amount: number }]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([accountId, merchantPattern])
  @@index([merchantPattern])
  @@index([accountId])
  @@index([status])
}
